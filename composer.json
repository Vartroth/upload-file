{
  "name": "vartroth/upload-file",
  "description": "Upload File",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Adrián González",
      "email": "info.agonzalez@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Vartroth\\UploadFile\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vartroth\\UploadFile\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "vartroth/functions-utils": "^1.0.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.1",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-parallel-lint/php-console-highlighter": "^1.0",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "scripts": {
    "test": [
      "./vendor/bin/phpunit --no-coverage --do-not-record-test-run-history",
      "./vendor/bin/parallel-lint --exclude vendor --exclude index.php .",
      "./vendor/bin/phpcs --standard=phpcs.xml.dist"
    ],
    "test:coverage": "./vendor/bin/phpunit --do-not-record-test-run-history --coverage-html .phpunit.cache/coverage",
    "server": "php -S 127.0.0.1:8080"
  }
}
